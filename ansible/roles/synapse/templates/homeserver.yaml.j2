# Managed by Ansible
server_name: "{{ matrix_domains.synapse }}"
public_baseurl: "https://{{ matrix_domains.synapse }}/"

listeners:
  - port: 8008
    bind_addresses: ['0.0.0.0']
    resources:
      - names:
          - client
{% if synapse_enable_federation | bool %}
          - federation
{% endif %}
        compress: false
{% if synapse_enable_metrics | bool %}
      - names: [metrics]
        compress: false
{% endif %}
    tls: false
    type: http
    x_forwarded: true

{% if synapse_enable_metrics | bool %}
enable_metrics: true
{% endif %}

database:
  name: psycopg2
  args:
    user: "{{ postgresql_synapse_user }}"
    password: "{{ postgresql_synapse_password }}"
    database: "{{ postgresql_synapse_db }}"
    host: "{{ postgresql_connect_host }}"
    port: 5432
    cp_min: 5
    cp_max: 20

log_config: "/data/log.config"
media_store_path: "/data/media"
report_stats: {{ synapse_report_stats | bool | lower }}
use_presence: {{ synapse_use_presence | bool | lower }}
enable_search: {{ synapse_enable_search | bool | lower }}
allow_guest_access: false

user_directory:
  enabled: true
  search_all_users: {{ synapse_user_directory_search_all_users | bool | lower }}
  prefer_local_users: {{ synapse_user_directory_prefer_local_users | bool | lower }}
  exclude_remote_users: {{ synapse_user_directory_exclude_remote_users | bool | lower }}
  show_locked_users: false

enable_registration: {{ synapse_registration_enabled | bool | lower }}
registration_shared_secret: "{{ synapse_registration_shared_secret }}"
macaroon_secret_key: "{{ synapse_macaroon_secret_key }}"
form_secret: "{{ synapse_form_secret }}"

trusted_key_servers:
  - server_name: matrix.org

trusted_reverse_proxies:
  - 127.0.0.1

default_room_version: '11'

federation_endpoint_timeout_ms: 15000

url_preview_enabled: {{ synapse_url_preview_enabled | bool | lower }}
url_preview_ip_range_blacklist:
  - '0.0.0.0/8'
  - '10.0.0.0/8'
  - '100.64.0.0/10'
  - '127.0.0.0/8'
  - '169.254.0.0/16'
  - '172.16.0.0/12'
  - '192.0.0.0/24'
  - '192.0.2.0/24'
  - '192.168.0.0/16'
  - '198.18.0.0/15'
  - '198.51.100.0/24'
  - '203.0.113.0/24'
  - '224.0.0.0/4'
  - '240.0.0.0/4'
  - '::/128'
  - '::1/128'
  - 'fc00::/7'
  - 'fe80::/10'
  - '2001:db8::/32'
  - 'ff00::/8'

max_event_delay_duration: 24h

rc_message:
  per_second: 0.5
  burst_count: 30

rc_delayed_event_mgmt:
  per_second: 1
  burst_count: 20

turn_uris:
  - "turn:{{ matrix_domains.turn }}:{{ coturn_udp_port }}?transport=udp"
  - "turn:{{ matrix_domains.turn }}:{{ coturn_udp_port }}?transport=tcp"
  - "turns:{{ matrix_domains.turn }}:{{ coturn_tls_port }}?transport=udp"
  - "turns:{{ matrix_domains.turn }}:{{ coturn_tls_port }}?transport=tcp"
turn_shared_secret: "{{ turn_shared_secret }}"
turn_user_lifetime: '1h'
turn_allow_guests: true
turn_server_name: "{{ matrix_domains.turn }}"

max_upload_size: '100M'
push:
  include_content: true

opentracing:
  enabled: false

signing_key_path: "/data/{{ matrix_domains.synapse }}.signing.key"

media_retention:
  local_media_lifetime: null
  remote_media_lifetime: null

matrix_rtc:
  transports:
    - type: livekit
      livekit_service_url: "https://{{ matrix_domains.livekit }}/livekit/jwt"

experimental_features:
  msc3266_enabled: true
  msc4143_enabled: true
  msc4222_enabled: true
