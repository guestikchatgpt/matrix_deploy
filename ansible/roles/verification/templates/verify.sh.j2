#!/bin/bash
set -u
set -o pipefail

PASS=0
WARN=0
FAIL=0

if [ -t 1 ] && command -v tput >/dev/null 2>&1 && [ -n "${TERM:-}" ] && [ "${TERM:-dumb}" != "dumb" ]; then
    GREEN="$(tput setaf 2)"
    YELLOW="$(tput setaf 3)"
    RED="$(tput setaf 1)"
    BOLD="$(tput bold)"
    RESET="$(tput sgr0)"
else
    GREEN=''
    YELLOW=''
    RED=''
    BOLD=''
    RESET=''
fi

ok() {
    printf '  %s[ OK ]%s %s\n' "$GREEN" "$RESET" "$*"
    PASS=$((PASS + 1))
}

warn() {
    printf '  %s[WARN]%s %s\n' "$YELLOW" "$RESET" "$*"
    WARN=$((WARN + 1))
}

fail() {
    printf '  %s[FAIL]%s %s\n' "$RED" "$RESET" "$*"
    FAIL=$((FAIL + 1))
}

section() {
    printf '\n%s== %s ==%s\n' "$BOLD" "$*" "$RESET"
}

service_check() {
    local name="$1"
    if systemctl is-active --quiet "$name"; then
        ok "systemd: $name active"
    else
        fail "systemd: $name inactive"
    fi
}

container_check() {
    local name="$1"
    local state
    state="$(docker inspect "$name" --format '{% raw %}{{.State.Status}}{% endraw %}' 2>/dev/null)" || state='missing'
    if [ "$state" != 'running' ]; then
        fail "container: $name state=$state"
        return
    fi
    # Docker health (only for images/containers that define a healthcheck).
    local health
    health="$(docker inspect "$name" --format '{% raw %}{{if .State.Health}}{{.State.Health.Status}}{{end}}{% endraw %}' 2>/dev/null)" || health=''
    case "$health" in
        ''|healthy) ok "container: $name running${health:+ ($health)}" ;;
        starting) warn "container: $name running (healthcheck still starting)" ;;
        *) fail "container: $name running but $health" ;;
    esac
}

container_image_check() {
    local name="$1"
    local expected="$2"
    local configured_ref
    local running_id
    local expected_id

    configured_ref="$(docker inspect "$name" --format '{% raw %}{{.Config.Image}}{% endraw %}' 2>/dev/null)" || configured_ref='missing'
    running_id="$(docker inspect "$name" --format '{% raw %}{{.Image}}{% endraw %}' 2>/dev/null)" || running_id='missing'
    expected_id="$(docker image inspect "$expected" --format '{% raw %}{{.Id}}{% endraw %}' 2>/dev/null)" || expected_id='missing'

    if [ "$configured_ref" = "$expected" ] && [ "$running_id" = "$expected_id" ] && [ "$expected_id" != 'missing' ]; then
        ok "image: $name = $expected"
    else
        fail "image: $name expected=$expected configured=$configured_ref running_id=$running_id expected_id=$expected_id"
    fi
}

http_check() {
    local label="$1"
    local url="$2"
    if curl -4fsS --max-time 10 "${CURL_LOCAL_RESOLVE[@]}" "$url" >/dev/null 2>&1; then
        ok "$label"
    else
        fail "$label"
    fi
}

listener_check() {
    local label="$1"
    local port="$2"
    if grep -Eq ":${port}[[:space:]]" <<<"$SOCKETS"; then
        ok "$label"
    else
        fail "$label"
    fi
}

ufw_rule_check() {
    local label="$1"
    local needle="$2"
    if grep -Fq "$needle" <<<"$UFW_STATUS"; then
        ok "$label"
    else
        fail "$label"
    fi
}

TARGET_IP="{{ matrix_external_ip }}"
SOCKETS="$(ss -lntup 2>/dev/null || true)"
UFW_STATUS="$(ufw status 2>/dev/null || true)"
CURL_LOCAL_RESOLVE=(
    --resolve '{{ matrix_domains.synapse }}:80:127.0.0.1'
    --resolve '{{ matrix_domains.synapse }}:443:127.0.0.1'
{% if synapse_enable_federation | bool %}
    --resolve '{{ matrix_domains.synapse }}:8448:127.0.0.1'
{% endif %}
    --resolve '{{ matrix_domains.element }}:443:127.0.0.1'
    --resolve '{{ matrix_domains.admin }}:443:127.0.0.1'
    --resolve '{{ matrix_domains.element_call }}:443:127.0.0.1'
    --resolve '{{ matrix_domains.livekit }}:443:127.0.0.1'
)

printf '%s====================================================%s\n' "$YELLOW" "$RESET"
printf '%s              Matrix stack verification%s\n' "$BOLD" "$RESET"
printf '%s====================================================%s\n' "$YELLOW" "$RESET"
printf 'Time:       %s UTC\n' "$(date -u '+%F %T')"
printf 'Target IP:  %s\n' "$TARGET_IP"

section 'System services'
for svc in docker nginx coturn fail2ban; do
    service_check "$svc"
done

section 'Docker containers'
for c in postgres synapse element-web synad element-call element-jwt livekit; do
    container_check "$c"
done

section 'Version lock / Docker images'
container_image_check 'postgres' '{{ postgresql_image }}'
container_image_check 'synapse' '{{ synapse_image }}'
container_image_check 'element-web' '{{ element_web_image }}'
container_image_check 'synad' '{{ synad_image }}'
container_image_check 'element-call' '{{ element_call_image }}'
container_image_check 'element-jwt' '{{ element_jwt_image }}'
container_image_check 'livekit' '{{ livekit_image }}'

section 'Network listeners'
listener_check 'nginx HTTP :80' 80
listener_check 'nginx HTTPS :443' 443
{% if synapse_enable_federation | bool %}
listener_check 'nginx federation :8448' 8448
{% else %}
if grep -Eq ':8448[[:space:]]' <<<"$SOCKETS"; then
    fail 'federation disabled, but :8448 is listening'
else
    ok 'federation disabled and :8448 is not listening'
fi
{% endif %}
listener_check 'legacy Coturn :{{ coturn_udp_port }}' {{ coturn_udp_port }}
listener_check 'legacy Coturn TLS :{{ coturn_tls_port }}' {{ coturn_tls_port }}
listener_check 'LiveKit TURN/UDP :{{ livekit_turn_udp_port }}' {{ livekit_turn_udp_port }}
listener_check 'LiveKit TURN/TLS :{{ livekit_turn_tls_port }}' {{ livekit_turn_tls_port }}
listener_check 'LiveKit RTC/TCP :{{ livekit_rtc_tcp_port }}' {{ livekit_rtc_tcp_port }}
listener_check 'LiveKit API :{{ livekit_http_port }} listening locally' {{ livekit_http_port }}

section 'UFW'
if grep -q '^Status: active' <<<"$UFW_STATUS"; then
    ok 'UFW active'
else
    fail 'UFW inactive'
fi
ufw_rule_check '{{ matrix_ssh_port }}/tcp SSH allowed' '{{ matrix_ssh_port }}/tcp'
ufw_rule_check '80/tcp allowed' '80/tcp'
ufw_rule_check '443/tcp allowed' '443/tcp'
{% if synapse_enable_federation | bool %}
ufw_rule_check '8448/tcp allowed' '8448/tcp'
{% else %}
if grep -Eq '8448/tcp[[:space:]]+ALLOW' <<<"$UFW_STATUS"; then
    fail '8448/tcp allowed while federation is disabled'
else
    ok '8448/tcp not allowed while federation is disabled'
fi
{% endif %}
ufw_rule_check 'legacy TURN {{ coturn_udp_port }}/tcp allowed' '{{ coturn_udp_port }}/tcp'
ufw_rule_check 'legacy TURN {{ coturn_udp_port }}/udp allowed' '{{ coturn_udp_port }}/udp'
ufw_rule_check 'legacy TURN TLS {{ coturn_tls_port }}/tcp allowed' '{{ coturn_tls_port }}/tcp'
ufw_rule_check 'legacy TURN relay {{ coturn_min_port }}:{{ coturn_max_port }}/udp allowed' '{{ coturn_min_port }}:{{ coturn_max_port }}/udp'
ufw_rule_check 'LiveKit TURN {{ livekit_turn_udp_port }}/udp allowed' '{{ livekit_turn_udp_port }}/udp'
ufw_rule_check 'LiveKit TURN/TLS {{ livekit_turn_tls_port }}/tcp allowed' '{{ livekit_turn_tls_port }}/tcp'
ufw_rule_check 'LiveKit RTC {{ livekit_rtc_tcp_port }}/tcp allowed' '{{ livekit_rtc_tcp_port }}/tcp'
ufw_rule_check 'LiveKit ICE {{ livekit_port_range_start }}:{{ livekit_port_range_end }}/udp allowed' '{{ livekit_port_range_start }}:{{ livekit_port_range_end }}/udp'
ufw_rule_check 'LiveKit TURN relay {{ livekit_turn_relay_range_start }}:{{ livekit_turn_relay_range_end }}/udp allowed' '{{ livekit_turn_relay_range_start }}:{{ livekit_turn_relay_range_end }}/udp'
if grep -Eq '{{ livekit_http_port }}/tcp[[:space:]]+ALLOW' <<<"$UFW_STATUS"; then
    fail '{{ livekit_http_port }}/tcp publicly allowed in UFW'
else
    ok '{{ livekit_http_port }}/tcp NOT publicly allowed'
fi

section 'PostgreSQL / Synapse'
if docker exec postgres pg_isready -U '{{ postgresql_synapse_user }}' -d '{{ postgresql_synapse_db }}' >/dev/null 2>&1; then
    ok 'PostgreSQL pg_isready'
else
    fail 'PostgreSQL pg_isready'
fi
http_check 'Synapse client API' 'https://{{ matrix_domains.synapse }}/_matrix/client/versions'
{% if synapse_enable_federation | bool %}
http_check 'Synapse federation API :8448' 'https://{{ matrix_domains.synapse }}:8448/_matrix/federation/v1/version'
{% endif %}
{% if synapse_enable_metrics | bool %}
if curl -fsS --max-time 5 http://127.0.0.1:8008/_synapse/metrics >/dev/null 2>&1; then
    ok 'Synapse metrics reachable locally'
else
    fail 'Synapse metrics not reachable locally'
fi
{% endif %}
PUBLIC_METRICS="$(curl -4sk --max-time 10 "${CURL_LOCAL_RESOLVE[@]}" -o /dev/null -w '%{http_code}' https://{{ matrix_domains.synapse }}/_synapse/metrics)"
if [ "$PUBLIC_METRICS" = '404' ]; then
    ok 'Synapse metrics closed to the outside'
else
    fail "Synapse metrics exposed externally: HTTP $PUBLIC_METRICS"
fi

section 'Web applications'
http_check 'Element Web' 'https://{{ matrix_domains.element }}/'
http_check 'Ketesa / Synapse Admin' 'https://{{ matrix_domains.admin }}/'
http_check 'Element Call' 'https://{{ matrix_domains.element_call }}/'
http_check 'LiveKit HTTPS frontend' 'https://{{ matrix_domains.livekit }}/'
http_check 'LiveKit JWT health' 'https://{{ matrix_domains.livekit }}/livekit/jwt/healthz'

section 'MatrixRTC discovery'
if curl -4fsS --max-time 10 "${CURL_LOCAL_RESOLVE[@]}" https://{{ matrix_domains.synapse }}/.well-known/matrix/client | python3 -c '
import json, sys
d = json.load(sys.stdin)
assert d["m.homeserver"]["base_url"] == "https://{{ matrix_domains.synapse }}"
foci = d.get("org.matrix.msc4143.rtc_foci", [])
assert any(x.get("type") == "livekit" and x.get("livekit_service_url") == "https://{{ matrix_domains.livekit }}/livekit/jwt" for x in foci)
' >/dev/null 2>&1; then
    ok 'MatrixRTC .well-known fallback (rtc_foci, deprecated) is correct'
else
    fail 'MatrixRTC .well-known fallback (rtc_foci) is incorrect'
fi

# MSC4519 transports endpoint (primary discovery since Element Call v0.24.0).
# It requires authentication: 401 proves the route is enabled, while 404
# (M_UNRECOGNIZED) means msc4143_enabled/matrix_rtc is not in effect.
RTC_TRANSPORTS_CODE="$(curl -4sk --max-time 10 "${CURL_LOCAL_RESOLVE[@]}" -o /dev/null -w '%{http_code}' https://{{ matrix_domains.synapse }}/_matrix/client/unstable/org.matrix.msc4143/rtc/transports)"
if [ "$RTC_TRANSPORTS_CODE" = '401' ]; then
    ok 'MatrixRTC transports endpoint (MSC4519) enabled'
else
    fail "MatrixRTC transports endpoint (MSC4519): HTTP $RTC_TRANSPORTS_CODE, expected 401"
fi
# lk-jwt-service validates OpenID tokens here in both federation modes.
OPENID_CODE="$(curl -4sk --max-time 10 "${CURL_LOCAL_RESOLVE[@]}" -o /dev/null -w '%{http_code}' 'https://{{ matrix_domains.synapse }}/_matrix/federation/v1/openid/userinfo?access_token=matrix-verify-invalid')"
if [ "$OPENID_CODE" = '401' ]; then
    ok 'OpenID userinfo for lk-jwt-service reachable'
else
    fail "OpenID userinfo for lk-jwt-service: HTTP $OPENID_CODE, expected 401"
fi

section 'LiveKit configuration'
if grep -Eq '^[[:space:]]*-[[:space:]]*"?http://127\.0\.0\.1:{{ element_jwt_host_port }}/sfu_webhook"?[[:space:]]*$' '{{ livekit_config_path }}'; then
    ok 'LiveKit webhook -> lk-jwt-service /sfu_webhook'
else
    fail 'LiveKit webhook to lk-jwt-service /sfu_webhook is not configured'
fi
JWT_WEBHOOK_CODE="$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' -X POST http://127.0.0.1:{{ element_jwt_host_port }}/sfu_webhook)"
# lk-jwt-service answers 200 to every webhook delivery (so LiveKit never
# retries); signature verification happens internally and unsigned events are
# dropped. The route therefore exists unless the answer is 404 or no answer.
case "$JWT_WEBHOOK_CODE" in
    2??|4??)
        if [ "$JWT_WEBHOOK_CODE" = '404' ]; then
            fail 'lk-jwt-service does not serve /sfu_webhook (HTTP 404)'
        else
            ok "lk-jwt-service /sfu_webhook reachable (HTTP $JWT_WEBHOOK_CODE)"
        fi
        ;;
    *) fail "lk-jwt-service /sfu_webhook: HTTP $JWT_WEBHOOK_CODE" ;;
esac
if grep -Eq '^[[:space:]]*auto_create:[[:space:]]*false' '{{ livekit_config_path }}'; then
    ok 'room.auto_create=false'
else
    fail 'room.auto_create != false'
fi
if grep -Eq '^[[:space:]]*relay_range_start:[[:space:]]*{{ livekit_turn_relay_range_start }}' '{{ livekit_config_path }}' && \
   grep -Eq '^[[:space:]]*relay_range_end:[[:space:]]*{{ livekit_turn_relay_range_end }}' '{{ livekit_config_path }}'; then
    ok 'embedded TURN relay = {{ livekit_turn_relay_range_start }}-{{ livekit_turn_relay_range_end }}'
else
    fail 'embedded TURN relay range is incorrect'
fi
if curl -fsS --max-time 5 http://127.0.0.1:{{ livekit_http_port }}/ >/dev/null 2>&1; then
    ok 'LiveKit API reachable locally :{{ livekit_http_port }}'
else
    fail 'LiveKit API not reachable locally :{{ livekit_http_port }}'
fi

section 'TLS'
LIVEKIT_TLS="$(timeout 10 openssl s_client -connect 127.0.0.1:{{ livekit_turn_tls_port }} -servername {{ matrix_domains.livekit }} -verify_return_error </dev/null 2>&1 || true)"
if grep -q 'Verify return code: 0' <<<"$LIVEKIT_TLS"; then
    ok 'LiveKit TURN/TLS :{{ livekit_turn_tls_port }} certificate'
else
    fail 'LiveKit TURN/TLS :{{ livekit_turn_tls_port }} certificate'
fi
COTURN_TLS="$(timeout 10 openssl s_client -connect 127.0.0.1:{{ coturn_tls_port }} -servername {{ matrix_domains.turn }} -verify_return_error </dev/null 2>&1 || true)"
if grep -q 'Verify return code: 0' <<<"$COTURN_TLS"; then
    ok 'legacy Coturn TLS :{{ coturn_tls_port }} certificate'
else
    fail 'legacy Coturn TLS :{{ coturn_tls_port }} certificate'
fi
if openssl x509 -checkend 2592000 -noout -in '/etc/letsencrypt/live/{{ matrix_domains.synapse }}/fullchain.pem' >/dev/null 2>&1; then
    ok 'Matrix SAN certificate >30 days'
else
    fail 'Matrix SAN certificate expires within 30 days'
fi
if openssl x509 -checkend 2592000 -noout -in '/etc/letsencrypt/live/{{ matrix_domains.turn }}/fullchain.pem' >/dev/null 2>&1; then
    ok 'TURN certificate >30 days'
else
    fail 'TURN certificate expires within 30 days'
fi
MATRIX_CERT="$(sha256sum '/etc/letsencrypt/live/{{ matrix_domains.synapse }}/fullchain.pem' | awk '{print $1}')"
LIVEKIT_CERT="$(sha256sum '{{ livekit_cert_dir }}/turn.crt' | awk '{print $1}')"
if [ "$MATRIX_CERT" = "$LIVEKIT_CERT" ]; then
    ok 'LiveKit cert copy matches the LE lineage'
else
    fail 'LiveKit cert copy does NOT match the LE lineage'
fi
TURN_CERT="$(sha256sum '/etc/letsencrypt/live/{{ matrix_domains.turn }}/fullchain.pem' | awk '{print $1}')"
COTURN_CERT="$(sha256sum '{{ coturn_cert_path }}' | awk '{print $1}')"
if [ "$TURN_CERT" = "$COTURN_CERT" ]; then
    ok 'Coturn cert copy matches the LE lineage'
else
    fail 'Coturn cert copy does NOT match the LE lineage'
fi

section 'Certbot / ACME'
if systemctl is-enabled --quiet certbot.timer; then ok 'certbot.timer enabled'; else fail 'certbot.timer disabled'; fi
if systemctl is-active --quiet certbot.timer; then ok 'certbot.timer active'; else fail 'certbot.timer inactive'; fi
if bash -n /etc/letsencrypt/renewal-hooks/deploy/matrix-stack.sh >/dev/null 2>&1; then ok 'Certbot deploy hook syntax'; else fail 'Certbot deploy hook syntax'; fi
TOKEN="matrix-verify-$$"
VALUE="matrix-verify-ok-$$"
FILE="{{ nginx_sites_root }}/.well-known/acme-challenge/$TOKEN"
mkdir -p '{{ nginx_sites_root }}/.well-known/acme-challenge'
printf '%s\n' "$VALUE" > "$FILE"
chmod 0644 "$FILE"
ACME_FAILED=0
for host in '{{ matrix_domains.synapse }}' '{{ matrix_domains.element }}' '{{ matrix_domains.admin }}' '{{ matrix_domains.element_call }}' '{{ matrix_domains.livekit }}' '{{ matrix_domains.turn }}'; do
    body="$(curl -4fsS --max-time 10 --resolve "${host}:80:127.0.0.1" "http://${host}/.well-known/acme-challenge/${TOKEN}" 2>/dev/null)" || body=''
    if [ "$body" != "$VALUE" ]; then
        fail "ACME HTTP-01: $host"
        ACME_FAILED=1
    fi
done
rm -f "$FILE"
if [ "$ACME_FAILED" -eq 0 ]; then ok 'ACME HTTP-01 routing works locally for all Matrix hostnames'; fi

section 'Fail2ban'
F2B_PING="$(fail2ban-client ping 2>/dev/null || true)"
if grep -q 'Server replied: pong' <<<"$F2B_PING"; then ok 'Fail2ban daemon responds'; else fail 'Fail2ban daemon does not respond'; fi
if fail2ban-client status sshd >/dev/null 2>&1; then ok 'Fail2ban jail sshd active'; else fail 'Fail2ban jail sshd is missing'; fi
BANNED="$(fail2ban-client get sshd banned 2>/dev/null || true)"
if [ -n "$BANNED" ] && [ "$BANNED" != '[]' ]; then
    ok "Fail2ban sshd has ban entries: $BANNED"
else
    warn 'Fail2ban sshd has no active ban entries yet'
fi

section 'Nginx'
if nginx -t >/dev/null 2>&1; then ok 'nginx configuration syntax'; else fail 'nginx configuration syntax'; fi

printf '\n%s====================================================%s\n' "$YELLOW" "$RESET"
printf 'Summary: %sOK=%d%s  %sWARN=%d%s  %sFAIL=%d%s\n' "$GREEN" "$PASS" "$RESET" "$YELLOW" "$WARN" "$RESET" "$RED" "$FAIL" "$RESET"
printf '%s====================================================%s\n' "$YELLOW" "$RESET"

if [ "$FAIL" -eq 0 ]; then
    printf '%sAll required checks passed.%s\n' "$GREEN" "$RESET"
    exit 0
fi

printf '%sFailures detected: %d%s\n' "$RED" "$FAIL" "$RESET"
exit 1
