server {
    listen 80 default_server;
    server_name _;
    root {{ nginx_sites_root }};

    location ^~ /.well-known/acme-challenge/ {
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 200 "Matrix bootstrap - waiting for TLS provisioning\n";
        add_header Content-Type text/plain;
    }
}
